# Copy this file to .env and fill in your values
# cp .env.example .env

# ── Security ──────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-random-32-char-string
DATABASE_URL=sqlite+aiosqlite:///./data/knowledge.db

# ── Embedding provider ────────────────────────────────────────────────────────
EMBEDDING_PROVIDER=local
LOCAL_EMBED_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384

# ── LLM provider (Ollama) ─────────────────────────────────────────────────────
# Install from https://ollama.com, then pull a model:
#   ollama pull llama3.1:8b
#   ollama pull mistral
#   ollama pull phi3
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# ── Offline enforcement ───────────────────────────────────────────────────────
TRANSFORMERS_OFFLINE=1
HF_DATASETS_OFFLINE=1

# ── Neo4j (primary graph + vector store) ─────────────────────────────────────
# Option A — Local Neo4j (default)
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-neo4j-password
NEO4J_DATABASE=neo4j

# Option B — Neo4j Aura (https://console.neo4j.io)
# NEO4J_URI=neo4j+s://<your-instance-id>.databases.neo4j.io
# NEO4J_USERNAME=<your-instance-id>
# NEO4J_PASSWORD=<your-aura-password>
# NEO4J_DATABASE=<your-instance-id>
# AURA_INSTANCEID=<your-instance-id>
# AURA_INSTANCENAME=Free instance

# Copy this file to .env and fill in your values
# cp .env.example .env

# ── Security ──────────────────────────────────────────────────────────────────
# JWT signing key. Required: the server refuses to start without a random value of
# 32+ characters (anyone who knows it can sign in as any user, admins included).
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Encrypts connector tokens / API keys stored in the database (AES-256-GCM).
# Without it, connectors that need a credential (GitHub token, Jira, Linear) can't be saved.
#   python -m app.crypto            (run inside backend/)
# Rotation: put the new key first, keep the old one after a comma, restart (stored
# credentials are re-encrypted with the new key at startup), then remove the old key.
CREDENTIALS_KEY=

# Folders that folder / git-ADR connectors may read, separated by ';' on Windows and
# ':' elsewhere. Empty = those connectors are disabled. Only admins can use them.
#   CONNECTOR_ROOTS=C:\Users\me\Meetings;C:\code
CONNECTOR_ROOTS=

# The first account created is the admin; everyone after is a member. Set SETUP_TOKEN
# on any server others can reach: registering that first account then asks for it.
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
SETUP_TOKEN=

# false = only an admin can create accounts (Users page / POST /admin/users).
ALLOW_REGISTRATION=true

# Sign-in throttling: 5 failed attempts per account and 30 in all per address every
# 15 minutes, 20 sign-ups per address an hour. false turns it off.
AUTH_RATE_LIMIT=true

# Interactive API docs at /docs, /redoc and /openapi.json (false hides them)
API_DOCS=true

# ── Inactivity retention ──────────────────────────────────────────────────────
# Accounts and groups unused for this many days are DELETED with all their data
# (checked at startup and then every RETENTION_CHECK_HOURS). The last server admin is
# never deleted. Server admins see what's due on the Users page.
RETENTION_INACTIVE_DAYS=365
RETENTION_CHECK_HOURS=24
RETENTION_ENABLED=true

# ── Embedding provider ────────────────────────────────────────────────────────
# Only local sentence-transformers is implemented ("local" is the only value).
EMBEDDING_PROVIDER=local
# After changing the model, run "Re-embed knowledge base" in Model Manager
# (POST /knowledge/reembed). The vector dimension comes from the model itself.
LOCAL_EMBED_MODEL=all-MiniLM-L6-v2

# ── LLM provider (Ollama) ─────────────────────────────────────────────────────
# Install from https://ollama.com and keep it running. The app supports exactly three
# models and offers to download one at sign-in if none is installed; to pull one yourself
# use the exact tag:
#   ollama pull llama3.1:8b   |   ollama pull mistral:7b   |   ollama pull gpt-oss:20b
# Not used: a model's id picks its provider (hosted models are configured below).
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
# Preferred model for users who have not picked one yet (if installed). Users choose
# their own model in Model Manager; only llama3.1:8b, mistral:7b and gpt-oss:20b are supported.
OLLAMA_MODEL=llama3.1:8b
# Context window in tokens (Ollama defaults to 2-4k, which truncates extraction prompts)
OLLAMA_NUM_CTX=8192
# false = no local models; only the hosted models below (Ollama is never contacted)
OLLAMA_ENABLED=true

# ── Single sign-on (optional, docs/sso.md) ────────────────────────────────────
# Redirect URI to register with each provider: <PUBLIC_URL>/auth/sso/<id>/callback
#PUBLIC_URL=https://hub.example.com
#SSO_PROVIDERS=google,microsoft
#SSO_GOOGLE_CLIENT_ID=
#SSO_GOOGLE_CLIENT_SECRET=
#SSO_MICROSOFT_CLIENT_ID=
#SSO_MICROSOFT_CLIENT_SECRET=
# any other OpenID Connect provider also needs its issuer, e.g.
#SSO_OKTA_ISSUER=https://acme.okta.com

# ── Hosted models (optional): an OpenAI-compatible API ────────────────────────
# OpenAI, Azure OpenAI (v1), OpenRouter, Groq, vLLM, LM Studio, LiteLLM ... Users who
# choose one of these models send it the text being extracted and the knowledge used to
# answer their questions (docs/hosted-models.md). Nothing is sent unless both the URL and
# the model list are set. OPENAI_API_KEY is deliberately not read.
#LLM_API_BASE_URL=https://api.openai.com/v1
#LLM_API_KEY=
#LLM_API_MODELS=gpt-4.1-mini,gpt-4.1
#LLM_API_NAME=OpenAI
# Model for users who haven't chosen one (e.g. api/gpt-4.1-mini); default OLLAMA_MODEL
#LLM_DEFAULT_MODEL=

# Max size of an uploaded file or fetched URL, in MB (also caps request bodies)
MAX_UPLOAD_MB=20

# GraphRAG: extra LLM calls per question, each about as slow as the answer itself on a
# CPU. Off by default: on evals/ they didn't make answers better (see backend/evals/).
#   GRAPHRAG_RERANK: rerank retrieved candidates (only with more than 2x top_k of them)
#   GRAPHRAG_QUERY_REWRITE: rewrite the question into sub-queries + a hypothetical answer
#   GRAPHRAG_LLM_ROUTE: classify questions the embedding classifier is unsure about
GRAPHRAG_RERANK=off
GRAPHRAG_QUERY_REWRITE=off
GRAPHRAG_LLM_ROUTE=off
# How long Ollama keeps the model loaded between calls (its default unloads it after 5 min)
OLLAMA_KEEP_ALIVE=30m

# ── Offline enforcement ───────────────────────────────────────────────────────
TRANSFORMERS_OFFLINE=1
HF_DATASETS_OFFLINE=1

# ── ArcadeDB (the only data store: graph, documents, vector + full-text indexes)
# Run it with Docker:
#   docker run -d --name arcadedb --restart unless-stopped -p 2480:2480 -v arcadedb-data:/home/arcadedb/databases \
#     -e JAVA_OPTS="-Darcadedb.server.rootPassword=change-me" arcadedata/arcadedb:26.9.1
# (8+ character password; the named volume keeps your data across container restarts and upgrades)
# The database is created and its schema applied on startup.
ARCADEDB_URL=http://localhost:2480
ARCADEDB_DATABASE=knowledge_hubs
ARCADEDB_USER=root
ARCADEDB_PASSWORD=change-me

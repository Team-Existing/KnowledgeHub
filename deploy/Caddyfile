# Load balancer + TLS + frontend.
#
# SITE_ADDRESS=localhost  -> HTTPS with a certificate from Caddy's own local CA
#                            (browsers warn until you trust it: `caddy trust`)
# SITE_ADDRESS=hub.acme.com -> a real certificate from Let's Encrypt, renewed
#                            automatically (ports 80 and 443 must be reachable)

{
	admin off
}

{$SITE_ADDRESS:localhost} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		-Server
	}

	# Content Security Policy: only this site's own scripts run, so injected markup
	# can't execute code or read the sign-in token. Inline styles are allowed (Angular
	# injects component styles); inline scripts and event handlers are not, which is
	# why angular.json turns off inlineCritical (it adds an onload= handler).
	# Not on the API docs pages: Swagger UI loads from a CDN, and the production stack
	# turns those pages off (API_DOCS=false).
	@csp not path /docs* /redoc*
	header @csp Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"

	# Some API prefixes are also app routes (/knowledge, /connectors, /groups, /organizations,
	# /admin/users): a browser page load (GET accepting HTML) gets the app.
	# Vary: Accept keeps the browser from answering the app's own API request
	# for such a path with the page it cached on a reload, and vice versa.
	@shared path /knowledge* /connectors* /groups* /organizations* /admin*
	header @shared Vary Accept
	@page {
		method GET
		header Accept *text/html*
		# sign-in redirects (browser navigations) go to the API: services/sso.py
		not path /docs* /openapi.json /auth/sso/*
	}
	handle @page {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	@api path /auth* /admin* /spaces* /groups* /organizations* /invitations* /knowledge* /connectors* /models* /health* /docs* /openapi.json
	handle @api {
		reverse_proxy {$APP_UPSTREAMS} {
			lb_policy round_robin
			# if an instance is down, retry the request on another one (only when it
			# never reached the instance, so a write is never sent twice)
			lb_try_duration 10s
			fail_duration 30s
			health_uri /health
			health_interval 10s
			health_timeout 5s
			# model downloads stream progress as server-sent events
			flush_interval -1
		}
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}

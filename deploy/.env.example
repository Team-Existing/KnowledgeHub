# Copy to deploy/.env and fill in. Compose reads it for variable substitution;
# each container only receives the variables docker-compose.yml passes to it.

# ── Address ───────────────────────────────────────────────────────────────────
# localhost = HTTPS with Caddy's local CA. A real domain = Let's Encrypt (ports 80/443 open).
SITE_ADDRESS=localhost
LB_HTTP_PORT=80
LB_HTTPS_PORT=443

# ── Secrets (generate each one; never reuse the examples) ─────────────────────
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# python -m app.crypto   (in backend/)  -- needed for connectors that store a token
CREDENTIALS_KEY=
# ArcadeDB root: used ONLY by the one-off provisioning job, never by the app
ARCADEDB_ROOT_PASSWORD=
# The app's own ArcadeDB user (created by provisioning; access to its database only)
ARCADEDB_APP_USER=kh_app
ARCADEDB_APP_PASSWORD=
ARCADEDB_DATABASE=knowledge_hubs
REDIS_PASSWORD=

# ── Local AI ──────────────────────────────────────────────────────────────────
# Ollama running on the Docker host
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1:8b

# ── Folder / git-ADR connectors ───────────────────────────────────────────────
# A host directory, mounted read-only at /data/sources in the app and worker containers.
# Point folder connectors at paths under /data/sources.
CONNECTOR_SOURCES_DIR=./sources

# ── Accounts and retention ────────────────────────────────────────────────────
ALLOW_REGISTRATION=true
RETENTION_ENABLED=true
RETENTION_INACTIVE_DAYS=365
RETENTION_CHECK_HOURS=24
MAX_UPLOAD_MB=20

# ── Background worker ─────────────────────────────────────────────────────────
# If a worker dies mid-sync (crash, kill -9), the sync is re-queued after this many
# seconds. Keep it longer than your longest sync.
CELERY_VISIBILITY_TIMEOUT=7200
